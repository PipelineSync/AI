# PipelineSync AI - local environment (copy to .env for local dev, or set the same names in
# Netlify -> Site configuration -> Environment variables for the deployed site).
# .env is gitignored. Never put any of these in public/ or in a Netlify build that reaches the browser.

# ---- Voice layer (ChatGPT takeover of the discovery call) ----
# Without this key the call still runs (built-in guardrail questions spoken by the browser voice),
# but ChatGPT does not word the turns and OpenAI does not speak them.
OPENAI_API_KEY=

# openai (default when the key is set) | simulated (force the built-in interviewer)
VOICE_PROVIDER=

# Models. Defaults shown; see docs/VOICE_SETUP.md for cheaper or better options.
OPENAI_CHAT_MODEL=gpt-4o-mini          # wording of each turn (strict JSON schema)
OPENAI_TTS_MODEL=gpt-4o-mini-tts      # the voice the client hears (~USD 0.015 per minute)
OPENAI_TTS_VOICE=alloy                # alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_STT_MODEL=gpt-4o-transcribe    # speech to text (gpt-4o-mini-transcribe is cheaper)

# Delivery of the voice: how it should sound on the phone.
# VOICE_TTS_INSTRUCTIONS=Speak like a warm, calm, real human interviewer on a phone call: natural pace, friendly, unhurried, no radio voice, no salesmanship.

# Optional: point the voice layer at a gateway, an Azure-compatible endpoint, or the bundled mock
# (node test/mock-openai.js 8099). Leave unset for the real OpenAI API.
# OPENAI_BASE_URL=http://127.0.0.1:8099/v1

# auto | browser | openai - which microphone engine the client uses to hear the answer.
# auto: the browser when it supports speech recognition (free, instant), OpenAI otherwise.
VOICE_STT=auto
VOICE_LANGUAGE=en
VOICE_LOCALE=en-PH
VOICE_MAX_TURNS=40
# VOICE_TIMEOUT_MS=45000

# ---- Prototype auth ----
# Signs the entry-gate session tokens (and the voice call tickets). Use a long random string on a shared deploy.
PS_TOKEN_SECRET=
