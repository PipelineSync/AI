# PipelineSync AI - local environment (copy to .env for local dev, or set the same names in
# Netlify -> Site configuration -> Environment variables for the deployed site).
# .env is gitignored. Never put any of these in public/ or in a Netlify build that reaches the browser.

# ---- Voice layer (ChatGPT takeover of the discovery call) ----
# Without this key the call still runs (built-in guardrail questions spoken by the browser voice),
# but ChatGPT does not word the turns and OpenAI does not speak them.
OPENAI_API_KEY=

# openai (default when the key is set) | simulated (force the built-in interviewer)
VOICE_PROVIDER=

# Models. Defaults shown; see docs/VOICE_SETUP.md for cheaper or better options.
OPENAI_CHAT_MODEL=gpt-4o-mini          # wording of each turn (strict JSON schema)
OPENAI_TTS_MODEL=gpt-4o-mini-tts      # the voice the client hears (~USD 0.015 per minute)
OPENAI_TTS_VOICE=alloy                # alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_STT_MODEL=gpt-4o-transcribe    # speech to text (gpt-4o-mini-transcribe is cheaper)

# ---- Continuous call (OpenAI Realtime over WebRTC) ----
# On by default whenever OPENAI_API_KEY is set: one WebRTC session carries the whole call, the model
# hears the answer and decides when the client has finished, so nothing is cut between questions.
# If the browser cannot do WebRTC, the mic is blocked, or the session cannot be opened, the same call
# falls back to the step-by-step engine below automatically (nothing is lost, nothing to configure).
# Set to off to force the step-by-step call everywhere (the emergency switch).
# VOICE_REALTIME=off

# Realtime model and voice. The first name that the account accepts is used; the built-in fallbacks
# are gpt-realtime-2.1 -> gpt-realtime -> gpt-realtime-2, and marin -> alloy for the voice.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin

# When the model takes the turn back. semantic_vad (default) waits for the client to finish the
# thought; server_vad uses a fixed silence window instead.
# OPENAI_REALTIME_VAD=semantic_vad
# OPENAI_REALTIME_EAGERNESS=medium        # low | medium | high | auto (semantic_vad only)
# OPENAI_REALTIME_SILENCE_MS=700          # server_vad only
# OPENAI_REALTIME_VAD_THRESHOLD=0.5       # server_vad only

# Spend guards for one continuous call.
# OPENAI_REALTIME_MAX_MIN=15              # the session is closed politely at this point
# OPENAI_REALTIME_MAX_TOOLS=90            # tool calls per call before the server hangs up

# Delivery of the voice: how it should sound on the phone.
# VOICE_TTS_INSTRUCTIONS=Speak like a warm, calm, real human interviewer on a phone call: natural pace, friendly, unhurried, no radio voice, no salesmanship.

# Optional: point the voice layer at a gateway, an Azure-compatible endpoint, or the bundled mock
# (node test/mock-openai.js 8099). Leave unset for the real OpenAI API.
# OPENAI_BASE_URL=http://127.0.0.1:8099/v1

# auto | browser | openai - which microphone engine the client uses to hear the answer.
# auto: the browser when it supports speech recognition (free, instant), OpenAI otherwise.
VOICE_STT=auto
VOICE_LANGUAGE=en
VOICE_LOCALE=en-PH
VOICE_MAX_TURNS=40
# VOICE_TIMEOUT_MS=45000

# ---- Supabase lead storage ----
# Uses the SAME Supabase project as PipelineSync/Time-tracker. These are server-only values: never
# prefix the secret key with VITE_ and never put it in public/. If all three are omitted, local demos
# and tests run without persistence; a partially configured set fails closed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback if the project has not moved to Supabase secret keys:
# SUPABASE_SERVICE_ROLE_KEY=
# auth.users.id of the Time-tracker workspace admin who owns incoming leads.
PIPELINESYNC_WORKSPACE_OWNER_ID=

# ---- Prototype auth ----
# Signs the entry-gate session tokens (and the voice call tickets). Use a long random string on a shared deploy.
PS_TOKEN_SECRET=

# ---- Anthropic Claude AI ----
# When set, the extract and generate endpoints use Claude (with PROMPT_A and PROMPT_B) instead of
# the deterministic mock logic. The key is read server-side only — never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
