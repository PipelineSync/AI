# PipelineSync AI - local environment (copy to .env for local dev, or set the same names in
# Netlify -> Site configuration -> Environment variables for the deployed site).
# .env is gitignored. Never put any of these in public/ or in a Netlify build that reaches the browser.

# ---- Voice layer (ChatGPT takeover of the discovery call) ----
# Without this key the call still runs (built-in guardrail questions spoken by the browser voice),
# but ChatGPT does not word the turns and OpenAI does not speak them.
OPENAI_API_KEY=

# openai (default when the key is set) | simulated (force the built-in interviewer)
VOICE_PROVIDER=

# Models. Defaults shown; see docs/VOICE_SETUP.md for cheaper or better options.
OPENAI_CHAT_MODEL=gpt-4o-mini          # wording of each turn (strict JSON schema)
OPENAI_TTS_MODEL=gpt-4o-mini-tts      # the voice the client hears (~USD 0.015 per minute)
OPENAI_TTS_VOICE=alloy                # alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_STT_MODEL=gpt-4o-transcribe    # speech to text (gpt-4o-mini-transcribe is cheaper)

# ---- Continuous call (OpenAI Realtime over WebRTC) ----
# On by default whenever OPENAI_API_KEY is set: one WebRTC session carries the whole call, the model
# hears the answer and decides when the client has finished, so nothing is cut between questions.
# If the browser cannot do WebRTC, the mic is blocked, or the session cannot be opened, the same call
# falls back to the step-by-step engine below automatically (nothing is lost, nothing to configure).
# Set to off to force the step-by-step call everywhere (the emergency switch).
# VOICE_REALTIME=off

# Realtime model and voice. The first name that the account accepts is used; the built-in fallbacks
# are gpt-realtime-2.1 -> gpt-realtime -> gpt-realtime-2, and marin -> alloy for the voice.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin

# Realtime uses semantic_vad with eagerness=medium by default, which suits most callers.
# Set OPENAI_REALTIME_EAGERNESS=low if callers get cut off; valid values are low, medium, high, auto.
# The server ignores invalid values and keeps the medium default.
# OPENAI_REALTIME_EAGERNESS=low
# interrupt_response=true lets the caller interrupt Otto.
# The app checks in gently after about 8 seconds of caller silence, offers a skip at 20 seconds,
# and keeps the existing idle wrap-up as the last resort. No VAD environment override is used.

# Spend guards for one continuous call. Both are enforced SERVER-SIDE: the call start time and the
# tool count live in a signed ticket the client cannot edit, and the server also remembers each call
# it opened, so re-issuing or dropping the ticket resets neither counter.
# OPENAI_REALTIME_MAX_MIN=15              # the session is closed politely at this point, by the server
# OPENAI_REALTIME_MAX_TOOLS=90            # tool calls per call before the server hangs up
# OPENAI_REALTIME_TIMEOUT_MS=9000         # the SDP handshake. Keep it inside your function timeout
                                          # (Netlify's default plan kills a function at 10s)

# Abuse controls on OPENING a paid session (all best effort per process - see docs/VOICE_SETUP.md
# section 4 for exactly how strong each one is, and what a shared store would add).
# OPENAI_REALTIME_CONNECT_PER_MIN=4       # new live sessions per minute per IP
# OPENAI_REALTIME_MAX_CONCURRENT=2        # live calls one signed-in address may hold at once
# OPENAI_REALTIME_DAILY_MAX=25            # live sessions per address per day
# OPENAI_REALTIME_IDLE_MIN=5              # last-resort wrap-up after this long without caller activity

# A visitor can also be told no by the HTTP flood guard on the route itself:
# VOICE_RATE_PER_MIN=                     # overrides every per-route voice limit (tests use 1000)

# Delivery of the voice: how it should sound on the phone.
# VOICE_TTS_INSTRUCTIONS=Speak like a warm, calm, real human interviewer on a phone call: natural pace, friendly, unhurried, no radio voice, no salesmanship.

# Optional: point the voice layer at a gateway, an Azure-compatible endpoint, or the bundled mock
# (node test/mock-openai.js 8099). Leave unset for the real OpenAI API.
# OPENAI_BASE_URL=http://127.0.0.1:8099/v1

# auto | browser | openai - which microphone engine the client uses to hear the answer.
# auto: the browser when it supports speech recognition (free, instant), OpenAI otherwise.
VOICE_STT=auto
VOICE_LANGUAGE=en
VOICE_LOCALE=en-PH
VOICE_MAX_TURNS=40
# VOICE_TIMEOUT_MS=45000

# ---- Supabase lead storage ----
# Uses the SAME Supabase project as PipelineSync/Time-tracker. These are server-only values: never
# prefix the secret key with VITE_ and never put it in public/. If all three are omitted, local demos
# and tests run without persistence; a partially configured set fails closed.
# NOTE: leaving placeholder values breaks the entry gate (returns 500 "lead database not configured").
# Uncomment and set real values only when you have a Supabase project.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=
# Legacy fallback if the project has not moved to Supabase secret keys:
# SUPABASE_SERVICE_ROLE_KEY=
# auth.users.id of the Time-tracker workspace admin who owns incoming leads.
# PIPELINESYNC_WORKSPACE_OWNER_ID=

# ---- Prototype auth ----
# Signs the entry-gate session tokens (and the voice call tickets). Use a long random string on a
# shared deploy: at least 16 characters, e.g. `openssl rand -hex 24`.
# On a production host (CONTEXT=production, NETLIFY=true or NODE_ENV=production) this is REQUIRED:
# the entry gate already refuses to run without it, and the live voice routes additionally fail
# closed if it is missing, shorter than 16 characters, or still the built-in development secret that
# is published in this repo - because a forgeable token would let a stranger spend your OpenAI
# credit. The refusal is reported as a configuration error that names the variable and never a
# value, and the call quietly carries on step by step. Local development is unaffected.
PS_TOKEN_SECRET=

# ---- HubSpot CRM ----
# Private App access token (pat-na1-...). Server-side only: never put this in public/ or a
# Netlify variable that reaches the browser. When unset, start/deliver stay mocked.
# Required scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.deals.read
#   crm.objects.deals.write
# If HUBSPOT_AUTO_CREATE_PROPS=true, also:
#   crm.schemas.contacts.write
#   crm.schemas.deals.write
# HUBSPOT_ACCESS_TOKEN=
# Public booking link for the "Book a call" screen (safe to expose: it is only rendered as
# the src of the HubSpot Meetings embed iframe). Replace your-team/your-meeting with the
# real path from HubSpot > Meetings > your scheduling page > Copy link. When unset, the
# booking screen falls back to "Request a time — we'll confirm by email".
# NOTE: leaving a placeholder breaks the booking screen (embeds a broken scheduler). Uncomment and set a real HubSpot Meetings link only when you have one.
# SCHEDULER_LINK=https://meetings.hubspot.com/your-team/your-meeting
# Create missing pipelinesync_* properties on first run (needs schema write scopes):
# HUBSPOT_AUTO_CREATE_PROPS=false

# ---- Resend: email delivery of the finished PDF (Phase 3) ----
# deliver emails the PDF to the address in the SIGNED SESSION TOKEN (never the address typed in the
# unlock form) as an attachment, through Resend's REST API over plain fetch - no npm package. The
# key is read server-side only and must never reach the browser. With no key the app still works:
# deliver reports email:{sent:false,error} and the finish screen tells the visitor to download.
#
# IMPORTANT: Resend only delivers to other people once the sending domain is verified with the DNS
# records Resend shows on its Domains page (SPF + DKIM). Until then Resend refuses every recipient
# except the address that owns the Resend account, so for a test deploy set PDF_EMAIL_FROM to
# Resend's test sender and unlock the PDF with that same address.
# Free accounts: 100 emails a day, 2 requests a second, 40MB per email including the attachment.
# PDF_EMAIL_API_KEY=
# PDF_EMAIL_FROM=PipelineSync AI <onboarding@resend.dev>   # replace with your verified domain
# PDF_EMAIL_SUBJECT=Your PipelineSync blueprint is attached  # {first_name} {name} {vertical} {tier} {date}
# PDF_EMAIL_REPLY_TO=

# Unlocks per minute per IP on /api/deliver (default 5). Each attempt builds a PDF and may send an
# email. The test suite raises this so one run does not trip the limiter; the deploy keeps 5.
# DELIVER_RATE_PER_MIN=5

# ---- Anthropic Claude AI ----
# When set, the extract and generate endpoints use Claude (with PROMPT_A and PROMPT_B) instead of
# the deterministic mock logic. The key is read server-side only — never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Model. Optional: defaults to the pinned model in lib/anthropic.js (DEFAULT_MODEL).
# This is the only knob; no other file hardcodes a model id.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#
# Blueprint generation runs as a Netlify background function and parks its result in
# Netlify Blobs. On Netlify the blob context is injected automatically. Set these two
# only when running the functions outside a Netlify deploy context:
# NETLIFY_BLOBS_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
#
# Force the /api/generate dispatcher to run the job inline instead of invoking the
# background function (useful with `netlify dev`):
# GENERATE_INLINE=1

# ---- Abuse protections (Phase 5) ----
# Cloudflare Turnstile at the entry gate, env-gated. When both are set, the start view
# renders the Turnstile widget (load https://challenges.cloudflare.com/turnstile/v0/api.js
# only in that case), and start.js verifies the token via POST
# https://challenges.cloudflare.com/turnstile/v0/siteverify (secret, response, remoteip)
# BEFORE any Supabase or HubSpot write. Failure → 403. When unset, behaviour is unchanged.
# TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Demo mode behind a flag. Only when DEMO_MODE=true does /api/config return demoMode:true
# and the UI show "Use the demo account" and the persona loader. When off, start.js
# rejects demo@pipelinesync.ai.
# DEMO_MODE=true

# Shared limits in Netlify Blobs (fallback to in-memory Map when Blobs unavailable):
# - Max 3 successful deliveries per email per 24h (sliding window)
# - Global daily cap on emails sent (to stay under Resend's free 100/day). Past the cap,
#   deliver still returns the PDF with email:{sent:false,error:"daily email limit reached"}.
# DELIVER_PER_EMAIL_DAY=3
# PDF_EMAIL_DAILY_MAX=80

# ---- Phase 7: HubSpot reliability + data hygiene ----
# Every HubSpot fetch uses AbortController timeout HUBSPOT_TIMEOUT_MS default 4000.
# Retry-After / backoff waits capped at 1000 ms.
# Entry gate total budget HUBSPOT_START_BUDGET_MS default 3500 — if exceeded, returns hubspot:{ok:false,pending:true} no contact id, deliver finds/creates later.
# HUBSPOT_TIMEOUT_MS=4000
# HUBSPOT_START_BUDGET_MS=3500
# Deal data: do not set amount from typical_deal_size unless HUBSPOT_DEAL_AMOUNT set. Keep size in contact prop only.
# HUBSPOT_DEAL_AMOUNT=
# Optional pipeline/stage internal IDs for new deals:
# HUBSPOT_DEAL_PIPELINE=
# HUBSPOT_DEAL_STAGE=
# Optional owner ID for new contacts and deals:
# HUBSPOT_OWNER_ID=
# Property auto-creation moved out of request path: run npm run hubspot:setup once. Keep fallback on 400 only when true.
# HUBSPOT_AUTO_CREATE_PROPS=false
# When 400 names no specific property, drops every custom prop, logs dropped list and includes droppedProps in result/note.

# ---- Phase 6: Security hardening + reliability ----
# Server-side blueprint only: /api/deliver now takes jobId, not blueprint. The job record stores
# token email + lead_id next to result (lib/job-store.js). Token email is used everywhere.
# EMAIL_VERIFY (default true): when true, PDF download is immediate, emailing requires 6-digit code.
# POST /api/deliver/code sends code to token email (fixed template), stores hash in Blobs 10-min expiry,
# max 3 sends/hour/email and 5 wrong attempts. Then /api/deliver with {jobId, code} sends PDF.
# EMAIL_VERIFY=true
# EMAIL_VERIFY_CODE_TTL_MIN=10
# EMAIL_VERIFY_MAX_SENDS_HOUR=3
# EMAIL_VERIFY_MAX_ATTEMPTS=5

# Idempotency: key=sha256(token email+jobId) stored in Blobs {dealId,emailSent,emailId,at}. Repeat
# returns PDF again duplicate:true, no new deal/email. body.resendEmail===true allows one extra send.
# Only first delivery writes blueprint_delivered event.

# Supabase failure must not block PDF: returns 200 with persistence:{ok:false}.

# Claude timeouts: callClaude takes timeoutMs via AbortController. runExtract total deadline
# AI_EXTRACT_DEADLINE_MS default 8000, retries fit inside remaining. Deadline hit -> fallback reason:"timeout".
# Generate uses AI_GENERATE_DEADLINE_MS default 60000. Frontend api.post 25s AbortController timeout with Try again.
# AI_EXTRACT_DEADLINE_MS=8000
# AI_GENERATE_DEADLINE_MS=60000

# ---- Consent and disclosure ----
# Privacy Policy URL must be https; otherwise treated as unset. Returned by /api/config as privacyPolicyUrl.
# If unset, server logs warning and shows notice without link. A real policy is required before public launch.
# PRIVACY_POLICY_URL=https://yourdomain.com/privacy

# Optional override for tests: point Turnstile verification at a mock server
# TURNSTILE_VERIFY_URL=http://127.0.0.1:8099/siteverify
